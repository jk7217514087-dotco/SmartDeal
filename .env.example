# SmartDeal Environment Variables Configuration Guide

# -----------------------------------------------------------------------------
# 1. Frontend Configuration (Vite)
# -----------------------------------------------------------------------------
# Base URL for SmartDeal Backend API (leave blank or set /api for same-origin / Vite proxy)
VITE_API_URL=http://localhost:3001/api

# Google OAuth 2.0 Web Client ID (Frontend)
# Obtain from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 2. Backend Server Configuration (Node.js)
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Google OAuth Client ID (Backend Token Verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 3. Email & Password Recovery Notification Configuration
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=GMAIL_SMTP
OWNER_EMAIL=jk7217514087@gmail.com
OWNER_PHONE=7217514087

# Option A: Gmail SMTP with 16-character Google App Password
# Generate from: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Option B: Resend API (Alternative Email Delivery)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# -----------------------------------------------------------------------------
# 4. Cellular SMS Gateway (Optional)
# -----------------------------------------------------------------------------
SMS_PROVIDER=FAST2SMS
FAST2SMS_API_KEY=your-fast2sms-api-key
